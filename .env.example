# ---------------------------------------------------------------------
# Copy to .env and fill in real values. Never commit .env.
# ---------------------------------------------------------------------

# Spring profile: dev | prod
SPRING_PROFILES_ACTIVE=prod

# --- Database ---------------------------------------------------------
DB_HOST=mysql
DB_PORT=3306
DB_NAME=attendance_saas
DB_USERNAME=attendance
DB_PASSWORD=change-me-strong-password
MYSQL_ROOT_PASSWORD=change-me-strong-root-password
# Host port MySQL is published on (change if 3306 is already taken)
DB_EXPOSED_PORT=3306

# --- JWT --------------------------------------------------------------
# Minimum 64 characters. Generate with: openssl rand -base64 64 | tr -d '\n'
JWT_SECRET=replace-this-with-a-random-secret-of-at-least-64-characters-length!!
# Access token lifetime in minutes
JWT_EXPIRATION=60
# Refresh token lifetime in days
JWT_REFRESH_EXPIRATION_DAYS=14

# --- HTTP -------------------------------------------------------------
SERVER_PORT=8080
NGINX_PORT=80
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://localhost:3000,http://localhost:5173

# Expose Swagger UI in the prod profile (keep false on a public deployment)
SWAGGER_ENABLED=true
